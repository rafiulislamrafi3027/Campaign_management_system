# Copy this file to ".env" and fill in your own values

PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/campaignhub

# Any long random text
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# First admin account (created by: npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@campaignhub.com
ADMIN_PASSWORD=admin123

# ---- Optional: send "Forgot password" codes by real email ----
# 1) Run:  npm install nodemailer
# 2) Gmail: turn on 2-Step Verification, then create an "App password"
#    (Google Account > Security > App passwords) and paste it below.
# If these are empty, the code is printed in the server terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampaignHub <your.email@gmail.com>

# ---- AI features (Gemini) ----
# Get a free key: https://aistudio.google.com/apikey  (sign in with Google > Create API key)
# Leave empty to turn AI off — everything else keeps working manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backups, tried automatically when the main model is busy
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
AI_TIMEOUT_MS=20000

# Optional: the website address printed on certificates for verification
# (leave empty to use the address the browser used, e.g. http://localhost:5001)
# PUBLIC_URL=https://campaignhub.example.com

# Optional: how many hours a private file link works (default 4)
# FILE_LINK_HOURS=4
